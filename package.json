{
  "name": "tasks-lite",
  "productName": "Tasks Lite",
  "version": "1.3.0",
  "description": "本地 CalDAV 待办客户端，直连 Radicale / 任意 CalDAV 服务器",
  "main": "src/main/index.js",
  "type": "commonjs",
  "author": "triple gold",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:portable": "electron-builder --win portable --x64",
    "test": "node test/ics-roundtrip.js && node test/store-unit.js && node test/parse-and-rrule.js && node test/conflict-unit.js && node scripts/check-dom.js"
  },
  "dependencies": {
    "ical.js": "2.2.1"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.gcaiso.taskslite",
    "productName": "Tasks Lite",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
